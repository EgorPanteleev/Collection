#version 450
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define TEXTURE_NUM 5

#include "layout.glsl"
#include "material.glsl"

Hit intersectLeafs(Ray ray, float eps, const uint id, const uint primCount, Hit closestHit) {
    for (uint i = 0; i < primCount; ++i) {
        PrecomputedTriangle tri = triangleBuffer.data[id + i];
        TriHit triHit = intersect(tri, ray, eps);
        if (triHit.t > eps && triHit.t < closestHit.t) {
            closestHit = Hit(id + i, triHit.t, triHit.u, triHit.v);
        }
    }
    return closestHit;
}

Hit intersect(Ray ray, float eps) {
    Hit closestHit = Hit(UINT_MAX, FLT_MAX, 0, 0);
    uint stack[16];
    uint sp = 0;
    stack[sp++] = 0;
    while (sp != 0) {
        uint nodeIdx = stack[--sp];
        Node node = nodeBuffer.data[nodeIdx];
        float tNode = intersect(node.bbox, ray);
        if (tNode == FLT_MAX || tNode >= closestHit.t) continue;
        uint primCount = primCount(node.index);
        if (primCount != 0) {
            uint id = id(node.index);
            for (uint i = 0; i < primCount; ++i) {
                PrecomputedTriangle tri = triangleBuffer.data[id + i];
                TriHit triHit = intersect(tri, ray, eps);
                if (triHit.t > eps && triHit.t < closestHit.t) {
                    closestHit = Hit(id + i, triHit.t, triHit.u, triHit.v);
                }
            }
        } else {
            uint leftIdx  = id(node.index);
            uint rightIdx = leftIdx + 1;
            Node left  = nodeBuffer.data[leftIdx];
            Node right = nodeBuffer.data[rightIdx];
            float tLeft  = intersect(left.bbox, ray);
            float tRight = intersect(right.bbox, ray);
            bool hitLeft  = (tLeft  != FLT_MAX) && (tLeft  < closestHit.t);
            bool hitRight = (tRight != FLT_MAX) && (tRight < closestHit.t);
            if (hitLeft && hitRight) {
                if (tLeft < tRight) {
                    stack[sp++] = rightIdx;
                    stack[sp++] = leftIdx;
                } else {
                    stack[sp++] = leftIdx;
                    stack[sp++] = rightIdx;
                }
            } else if (hitLeft) {
                stack[sp++] = leftIdx;
            } else if (hitRight) {
                stack[sp++] = rightIdx;
            }
        }
    }

    return closestHit;
}

#define skyColor vec3(0)

float getShadow(vec3 P, vec3 dir) {
    Ray shadowRay = makeRay(P, dir, 0.1, FLT_MAX);
    Hit shadowHit = intersect(shadowRay, 1e-6);

    if (shadowHit.id == UINT_MAX) return 1;
    return 0;
}

vec3 traceRay(vec3 rayDir, vec3 albedo, vec3 P, vec3 N) {
    uint seed = uint(gl_GlobalInvocationID.x) + uint(gl_GlobalInvocationID.y) * 1973u + pc.frame * 9277u;
    vec3 resultColor = vec3(0.0);
    vec3 throughput  = vec3(1.0);

    vec3 wo = -rayDir;
    vec3 L  = -directLight.dir.xyz;
    Scatter scatter = lambertianScatter(seed, albedo, N, wo);

    float cosTheta   = max(dot(N, L), 0.0);
    vec3  movedP     = P + N * 1e-3;
    vec3  directColor = scatter.brdf * cosTheta * directLight.intensity * getShadow(movedP, L);
    resultColor += directColor;
    throughput  *= scatter.brdf * dot(N, scatter.wi) / scatter.pdf;
    Ray currentRay = makeRay(movedP, scatter.wi, 0.1, FLT_MAX);

    for (uint depth = 1; depth < pc.maxDepth; ++depth) {
        Hit hit = intersect(currentRay, 1e-6);
        if (hit.id == UINT_MAX) {
            resultColor += throughput * skyColor;
            break;
        }
        PrecomputedTriangle tri = triangleBuffer.data[hit.id];
        TriangleExtra triExtra = triangleExtraBuffer.data[hit.id];
        vec2 uv = getUV(triExtra, hit.u, hit.v);
        vec3 albedo = texture(textures[nonuniformEXT(materialIndexBuffer.data[hit.id] * TEXTURE_NUM)], uv).rgb;
        vec3 P = currentRay.pos + currentRay.dir * hit.t;
        vec3 L = -directLight.dir.xyz;
        vec3 N = normalize(tri.N.xyz);
        N = faceforward(N, currentRay.dir, N);
        vec3 wo = -currentRay.dir;
        Scatter scatter = lambertianScatter(seed, albedo, N, wo);
        float cosTheta = max(dot(N,L), 0);
        vec3 movedP = P + N * 1e-3;
        vec3 directColor = scatter.brdf * cosTheta * directLight.intensity * getShadow(movedP, L);
        resultColor += throughput * directColor;
        throughput *= scatter.brdf * dot(N, scatter.wi) / scatter.pdf;
        //        if (depth >= 3) {
        //            float p = max(throughput.r, max(throughput.g, throughput.b));
        //            p = clamp(p, 0.05, 1.0);
        //            if (rand01(seed) > p) break;
        //            throughput /= p;
        //        }
        currentRay = makeRay(movedP, scatter.wi, 0.0, FLT_MAX);
    }
    return resultColor;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 wh = imageSize(outputImage);
    vec2 uv = coord / wh;
    float depth = texture(depthImage, uv).r;
    if (depth >= 1.0) {
        imageStore(outputImage, coord, vec4(skyColor, 1));
        return;
    }
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 world = camera.invViewProj * clip;
    world /= world.w;

    vec3 albedo = texture(colorImage, uv).rgb;
    vec3 P = world.xyz;
    vec3 N = texture(normalImage, uv).rgb;
    //vec3 N = texture(normalImage, uv).rgb * 2.0 - 1.0;
    vec3 rayDir = P - camera.pos.xyz;
    N = faceforward(N, rayDir, N);
    vec3 tracedColor = traceRay(rayDir, albedo, P, N);
    if (pc.frame == 0) {
        imageStore(outputImage, coord, vec4(tracedColor, 1.0));
        return;
    }
    vec3 imageColor = imageLoad(outputImage, coord).rgb;
    vec3 newColor = (imageColor * pc.frame + tracedColor) / (pc.frame + 1);
    imageStore(outputImage, coord, vec4(newColor, 1.0));
}
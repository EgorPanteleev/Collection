void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 wh = imageSize(image);
    vec2 uv = gl_GlobalInvocationID.xy / wh;
    vec3 color = texture(colorImage, uv).rgb;
    float depth = texture(depthImage, uv).r;
    imageStore(image, coord, vec4(color, 1.0));

    const float imagePlaneHeight = 2.0 * tan(radians(camera.FOV * 0.5));
    const float imagePlaneWidth  = imagePlaneHeight * camera.aspectRatio;

    const float u  = (coord.x + 0.5) / wh.x;
    const float px = (2.0 * u - 1.0) * imagePlaneWidth * 0.5;
    const float v  = (coord.y + 0.5) / wh.y;
    const float py = (2.0 * v - 1.0) * imagePlaneHeight * 0.5;
    vec3 dir = normalize(px * vec3(camera.right) + py * vec3(camera.up) + vec3(camera.forward));
    Ray ray = makeRay(vec3(camera.position), dir, camera.nearPlane, camera.farPlane);
    vec3 tracedColor = traceRay(ray);
    if (pc.frame == 0) {
        imageStore(image, coord, vec4(tracedColor, 1.0));
        return;
    }
    vec3 imageColor = imageLoad(image, coord).rgb;
    vec3 newColor = (imageColor * pc.frame + tracedColor) / (pc.frame + 1);
    imageStore(image, coord, vec4(newColor, 1.0));
}